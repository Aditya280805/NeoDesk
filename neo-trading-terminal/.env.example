# Multi-user NeoDesk trading terminal. Real-money order execution remains disabled in code.
ENVIRONMENT=development
PAPER_STARTING_BALANCE=100000
# Secret key used for signing JWT tokens. Set a random 32+ character string in production
# (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
# When left blank locally, NeoDesk generates and persists a secret in DATA_DIR/.jwt_secret.
JWT_SECRET=
# Optional legacy single-user terminal password fallback (at least 16 characters).
# APP_PASSWORD=
# DATA_DIR=/var/data
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
FRONTEND_URL=http://localhost:3000
MARKET_DATA_SOURCE=sample

# For real REST quotes set MARKET_DATA_SOURCE=kotak and add the consumer key.
# Tokens below are examples from the SDK; verify against the current instrument master.
KOTAK_INSTRUMENTS='[{"exchange_segment":"nse_cm","instrument_token":"1333"},{"exchange_segment":"nse_cm","instrument_token":"2885"}]'
# Copy this file to .env and fill values locally.
# Never commit or share .env. Enter the rotating TOTP interactively.
KOTAK_CONSUMER_KEY=
KOTAK_UCC=
KOTAK_MOBILE_NUMBER=
# MPIN and TOTP are entered in Connections or the local login check, never saved.
KOTAK_ENVIRONMENT=prod

# Optional backup model keys. Keep them private and use the same provider.
# OPENAI_BACKUP_API_KEY=
# GEMINI_BACKUP_API_KEY=
# EXTERNAL_MCP_CONFIG=/absolute/path/to/mcp.json

# Options monitoring agent: local Ollama OpenAI-compatible server
OPTIONS_AGENT_PROVIDER=ollama
OPTIONS_AGENT_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OPTIONS_AGENT_STREAM=true
OPTIONS_AGENT_ENABLED=true
# Optional cloud providers (explicitly set provider=gemini or openai with a key):
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# Private loopback listener; do not expose this port through a proxy.
OPTIONS_MCP_PORT=8766

# Overall agent deadline, including evidence capture and validation (browser allows 120s).
AGENT_REQUEST_TIMEOUT_SECONDS=110
